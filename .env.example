# ============================================================
# PAYVEXO ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env.local for development
# In production (Vercel, etc.), set these as environment variables
#
# IMPORTANT: Never commit real keys to source control.
# The .env.local file is git-ignored by default.
# ============================================================

# ── SUPABASE (Required) ──────────────────────────────────────
# All organizations share a single Supabase project.
# Data isolation is handled via organization_id scoping + RLS policies.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — NEVER expose to the client (no VITE_ prefix)
# Used only by server-side API routes (api/ folder)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── PUSH NOTIFICATIONS (Optional) ────────────────────────────
# VAPID keys are shared across all organizations.
# Generate once: npx web-push generate-vapid-keys
# Client-side: public key only
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-side: private key (no VITE_ prefix — server API only)
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@payvexo.com

# ── PAYSTACK BILLING (Required for subscriptions) ────────────
# Get keys from: https://dashboard.paystack.com → Settings → API Keys
# Client-side: public key only (opens payment popup)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-public-key

# Server-side: secret key (verifies payments) - NEVER expose to client
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# ── EMAIL SERVICE (Gmail SMTP) ──────────────────────────────────
# Shared across all orgs. Emails are sent on behalf of the platform.
# Server-side only (no VITE_ prefix)
#
# Steps:
# 1. Use/create a Gmail account
# 2. Enable 2-Step Verification at https://myaccount.google.com/security
# 3. Create App Password at https://myaccount.google.com/apppasswords
# 4. Paste the 16-char password below (no spaces)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Sender address (defaults to GMAIL_USER if not set)
FROM_EMAIL=your-gmail@gmail.com

# ── SMS SERVICE (Optional) ───────────────────────────────────
VITE_TERMII_API_KEY=your-termii-api-key

# ── APP CONFIG ────────────────────────────────────────────────
VITE_APP_NAME=Payvexo
VITE_APP_URL=https://payvexo.com

# Enable multi-tenant mode (should always be 'true' in production)
VITE_MULTI_TENANT=true

# Enable server-side uploads for receipts/expenses
VITE_USE_SERVER_UPLOAD=true

# ============================================================
# SECURITY NOTES
# ============================================================
# 1. Variables prefixed VITE_ are bundled into the client build
#    and visible to end users — only put public/non-sensitive
#    values here (anon key, VAPID public key, etc.)
#
# 2. Variables WITHOUT VITE_ prefix are server-side only.
#    They are available in API routes (api/) but never in the
#    browser bundle.
#
# 3. In a multi-tenant architecture, ALL organizations share:
#    - The same Supabase project (data isolated by org_id + RLS)
#    - The same VAPID keys (push subscriptions are per-browser)
#    - The same email/SMS provider credentials
#    - The same deployment (Vercel, etc.)
#
# 4. Organization-specific settings (branding, labels, etc.)
#    are stored in the organizations table, NOT in env vars.
#
# 5. For staging vs production, use separate .env files or
#    separate Vercel projects with different env variables.
# ============================================================
