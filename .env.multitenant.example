# Multi-Tenant Development Database
# DO NOT COMMIT THIS FILE - It's in .gitignore
#
# Instructions:
# 1. Create a new Supabase project at supabase.com/dashboard
# 2. Copy your new project's URL and anon key below
# 3. Rename this file to .env.multitenant
# 4. Copy to .env.local when working on multi-tenant branch

VITE_SUPABASE_URL=https://YOUR_NEW_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_new_anon_key_here

# Optional: Service role key for admin operations (keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
